SERVER_NAME=${server_name}
WORLD_NAME=${world_name}
SERVER_PASS=${server_password}
SERVER_PORT=2456
TZ=Europe/Berlin
# Steam matchmaking. Crossplay (PlayFab) was enabled 2026-11-22 and disabled the same
# day: the PlayFab socket kept failing with code 4098 "invalid handle", suspending TX
# and reconnecting mid-session. Explicit false rather than removing the line, so a
# future image default cannot silently re-enable it.
CROSSPLAY=false
# Keep a week of hourly world backups instead of the image default of 3 days.
BACKUPS_MAX_AGE=7
# Run the server as the valheim service account, so everything it writes into the
# /config bind mount is owned by valheim instead of root (the image defaults to 0).
PUID=${uid}
PGID=${gid}
